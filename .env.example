# Copy to .env and edit. Never commit your real .env.
# All values are optional; sensible defaults apply.

# --- Storage ---
DB_PATH=data/tracker.db
SOURCES_FILE=config/sources.json
RAW_RETENTION_HOURS=72

# --- Runtime and backup (not part of transferable data) ---
RUNTIME_DIR=runtime
LOG_DIR=logs
BACKUP_DIR=backups
AUTO_BACKUP=1
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
BACKUP_RETENTION_COUNT=30

# --- Web admin ---
WEB_HOST=127.0.0.1
WEB_PORT=8787

# --- Behaviour ---
# Treat preorder as purchasable (1) or not (0).
PREORDER_PURCHASABLE=0
# Suppress identical (offer,event) within this many seconds (anti-flap).
EVENT_COOLDOWN_SECONDS=21600
# Minimum relative price move to emit a price_change event.
PRICE_CHANGE_THRESHOLD=0.05

# --- HTTP client ---
HTTP_TIMEOUT_MS=15000
HTTP_MAX_RETRIES=3
HTTP_PER_HOST_INTERVAL_MS=2000
HTTP_USER_AGENT=BeybladeTracker/0.1 (+personal-use; respects robots and rate limits)
# Emergency kill switch: set to 0 to block every external scan, preview and notification.
NETWORK_ENABLED=1

# --- Debug ---
DEBUG_HTML=0
DEBUG_HTML_DIR=runtime/debug

# --- Optional external notifications (leave blank to disable) ---
# Nothing is sent externally unless BOTH the token/webhook are set.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
